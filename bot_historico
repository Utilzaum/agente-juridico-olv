def conectar_db():
    """Conecta ao banco SQLite."""
    return sqlite3.connect(DB_PATH)

def criar_tabela():
    """Cria a tabela de publicações se não existir."""
    conn = conectar_db()
    cursor = conn.cursor()
    
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS publicacoes (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        processo TEXT,
        tribunal TEXT,
        orgao_julgador TEXT,
        tipo_ato TEXT,
        data_publicacao TEXT,
        inicio_prazo TEXT,
        audiencia TEXT,
        autor TEXT,
        reu TEXT,
        conteudo TEXT,
        hash TEXT UNIQUE,
        data_criacao TEXT DEFAULT CURRENT_TIMESTAMP
    )
    """)
    
    # Índices para performance
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_processo ON publicacoes(processo)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_data_pub ON publicacoes(data_publicacao)")
    
    conn.commit()
    conn.close()

def gerar_hash_registro(reg: Dict) -> str:
    """Gera hash único baseado em processo + data + conteúdo."""
    base = f"{reg['processo']}_{reg['data_publicacao']}_{reg['conteudo']}"
    return hashlib.md5(base.encode("utf-8")).hexdigest()

def salvar_no_sqlite(dados: List[Dict]) -> Dict[str, int]:
    """Salva registros no SQLite com controle de duplicatas."""
    conn = conectar_db()
    cursor = conn.cursor()
    
    inseridos = 0
    ignorados = 0
    
    for reg in dados:
        try:
            hash_reg = gerar_hash_registro(reg)
            
            cursor.execute("""
            INSERT OR IGNORE INTO publicacoes (
                processo, tribunal, orgao_julgador, tipo_ato,
                data_publicacao, inicio_prazo, audiencia,
                autor, reu, conteudo, hash
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (
                reg["processo"], reg["tribunal"], reg["orgao_julgador"],
                reg["tipo_ato"], reg["data_publicacao"], reg["inicio_prazo"],
                reg["audiencia"], reg["autor"], reg["reu"], reg["conteudo"], hash_reg
            ))
            
            if cursor.rowcount > 0:
                inseridos += 1
            else:
                ignorados += 1
        except Exception as e:
            logger.warning(f"⚠️ Erro ao salvar: {e}")
            continue
    
    conn.commit()
    conn.close()
    logger.info(f"💾 SQLite: {inseridos} novos | {ignorados} duplicados")
    return {"inseridos": inseridos, "ignorados": ignorados}

def exportar_sqlite_para_excel() -> Optional[str]:
    """Exporta dados do SQLite para Excel."""
    logger.info("📊 Exportando do SQLite para Excel...")
    conn = conectar_db()
    df = pd.read_sql_query("SELECT * FROM publicacoes ORDER BY data_publicacao DESC", conn)
    conn.close()
    
    if df.empty:
        return None
    
    colunas = [
        "processo", "tribunal", "orgao_julgador", "tipo_ato",
        "data_publicacao", "inicio_prazo", "audiencia",
        "autor", "reu", "conteudo"
    ]
    df = df[[c for c in colunas if c in df.columns]]
    
    Path(OUTPUT_FILE).parent.mkdir(parents=True, exist_ok=True)
    df.to_excel(OUTPUT_FILE, index=False)
    logger.info(f"💾 {len(df)} registros exportados para: {OUTPUT_FILE}")
    return OUTPUT_FILE

def consultar_total_registros() -> int:
    """Retorna total de registros no banco."""
    conn = conectar_db()
    cursor = conn.cursor()
    cursor.execute("SELECT COUNT(*) FROM publicacoes")
    total = cursor.fetchone()[0]
    conn.close()
    return total

