def proximo_dia_util(data: datetime) -> datetime:
    """Calcula próximo dia útil (D+1)."""
    data += timedelta(days=1)
    while data.weekday() >= 5:
        data += timedelta(days=1)
    return data

def fazer_requisicao(url: str, params: dict) -> Optional[requests.Response]:
    """Requisição HTTP com retry."""
    headers = {
        "User-Agent": "Mozilla/5.0 (AgenteJuridico-DJEN/15.0)",
        "Accept": "application/json",
    }
    for tentativa in range(MAX_RETRIES):
        try:
            resp = requests.get(url, params=params, headers=headers, timeout=REQUEST_TIMEOUT)
            if resp.status_code == 200:
                return resp
            elif resp.status_code == 429:
                wait = RETRY_DELAY * (2 ** tentativa)
                logger.warning(f"⚠️ Rate limit. Aguardando {wait}s...")
                time.sleep(wait)
                continue
            else:
                logger.error(f"❌ HTTP {resp.status_code}: {resp.text[:200]}")
                return None
        except requests.exceptions.Timeout:
            logger.warning(f"⚠️ Timeout (tentativa {tentativa + 1}/{MAX_RETRIES})")
        except Exception as e:
            logger.error(f"❌ Erro: {e}")
            break
        if tentativa < MAX_RETRIES - 1:
            time.sleep(RETRY_DELAY * (2 ** tentativa))
    return None

# =========================
# 🔍 BUSCA NA API (AJUSTADA PARA DATA DINÂMICA)
# =========================
def buscar_publicacoes(data_str: str) -> List[Dict]:
    """
    Busca publicações da OAB 176629/RJ na API do PJe para uma data específica.
    """
    logger.debug(f"🔎 Buscando em {data_str}...")
    todas = []
    page = 1
    
    while True:
        params = {
            "numeroOab": OAB_NUMERO,
            "ufOab": OAB_UF,
            "dataDisponibilizacaoInicio": data_str,
            "dataDisponibilizacaoFim": data_str,
            "size": PAGE_SIZE,
            "page": page,
        }
        
        response = fazer_requisicao(BASE_URL, params)
        if not response:
            logger.warning(f"⚠️ Falha ao buscar {data_str} (página {page})")
            break
            
        try:
            dados = response.json()
        except ValueError as e:
            logger.error(f"❌ JSON inválido em {data_str}: {e}")
            break
        
        items = dados.get("items", [])
        if not items:
            break
            
        todas.extend(items)
        
        if len(items) < PAGE_SIZE:
            break
            
        page += 1
        time.sleep(REQUEST_DELAY)
    
    return todas

# =========================
# PROCESSAMENTO (mantido)
# =========================
def processar_publicacoes(publicacoes: List[Dict]) -> List[Dict]:
    """Processa publicações extraindo dados relevantes."""
    logger.debug(f"⚙️ Processando {len(publicacoes)} itens...")
    dados = []
    
    for item in publicacoes:
        try:
            # Data
            data_str = item.get("dataDisponibilizacao") or item.get("data_disponibilizacao")
            if not data_str:
                continue
            if isinstance(data_str, (int, float)):
                data_pub = datetime.fromtimestamp(data_str / 1000)
            else:
                data_pub = datetime.strptime(str(data_str)[:10], "%Y-%m-%d")
            inicio_prazo = proximo_dia_util(data_pub)
            
            # Campos
            processo = (item.get("numeroProcesso") or item.get("numero_processo") or item.get("npu") or "N/D")
            tribunal = (item.get("siglaTribunal") or item.get("tribunal") or "N/D")
            conteudo = (item.get("texto") or item.get("conteudo") or "")
            
            dados.append({
                "processo": str(processo).strip(),
                "tribunal": str(tribunal).strip(),
                "orgao_julgador": extrair_orgao(conteudo),
                "tipo_ato": extrair_tipo_ato(conteudo),
                "data_publicacao": data_pub.strftime("%d/%m/%Y"),
                "inicio_prazo": inicio_prazo.strftime("%d/%m/%Y"),
                "audiencia": extrair_audiencia(conteudo),
                "autor": extrair_partes(conteudo)[0],
                "reu": extrair_partes(conteudo)[1],
                "conteudo": str(conteudo).strip(),
            })
        except Exception:
            continue
    
    return dados

# Funções de extração (mantidas)
def extrair_tipo_ato(texto: str) -> str:
    t = texto.upper()
    if "AUDIÊNCIA" in t or "AUDIENCIA" in t:
        if "NÃO" not in t and "SEM" not in t:
            return "AUDIÊNCIA"
    if "SENTENÇA" in t or "SENTENCA" in t:
        return "SENTENÇA"
    if "ACÓRDÃO" in t or "ACORDAO" in t:
        return "ACÓRDÃO"
    if "DESPACHO" in t:
        return "DESPACHO"
    if "CITAÇÃO" in t or "CITACAO" in t:
        return "CITAÇÃO"
    if "INTIMAÇÃO" in t or "INTIMACAO" in t:
        return "INTIMAÇÃO"
    return "OUTROS"

def extrair_audiencia(texto: str) -> str:
    if "AUDIÊNCIA" not in texto.upper() and "AUDIENCIA" not in texto.upper():
        return ""
    import re
    m = re.search(r"(\d{2}/\d{2}/\d{4})\s+(?:às\s+)?(\d{2}:\d{2})", texto)
    if m:
        return f"{m.group(1)} {m.group(2)}"
    m = re.search(r"(\d{2}/\d{2}/\d{4})", texto)
    if m:
        return m.group(1)
    return ""

def extrair_partes(texto: str) -> tuple:
    import re
    autor, reu = "", ""
    m = re.search(r"(?:AUTOR|AUTORA|RECTE|REQUERENTE):\s*(.+?)(?=\s+(?:REU|RÉU|REQUERIDO|ADV|OAB|$))", texto, re.IGNORECASE)
    if m:
        autor = re.sub(r"\s*(OAB|CPF|CNPJ).*", "", m.group(1).strip(), flags=re.IGNORECASE).strip()
    m = re.search(r"(?:REU|RÉU|REQUERIDO|RECORRIDO):\s*(.+?)(?=\s+(?:AUTOR|ADV|OAB|$))", texto, re.IGNORECASE)
    if m:
        reu = re.sub(r"\s*(OAB|CPF|CNPJ).*", "", m.group(1).strip(), flags=re.IGNORECASE).strip()
    return autor[:100] if autor else "", reu[:100] if reu else ""

def extrair_orgao(texto: str) -> str:
    import re
    padroes = [
        r"(\d+[ªa°]?\s+VARA\s+[^\n]+?)(?=\n|$)",
        r"(JUÍZO\s+ESPECIAL\s+[^\n]+?)(?=\n|$)",
        r"(TURMA\s+RECURSAL\s+[^\n]+?)(?=\n|$)",
    ]
    for padrao in padroes:
        m = re.search(padrao, texto, re.IGNORECASE)
        if m:
            return m.group(1).strip()[:100]
    return "N/D"

