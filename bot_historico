# E-MAIL
# =========================
def enviar_email(arquivo: str, total: int):
    """Envia planilha por e-mail."""
    if not SENDGRID_API_KEY:
        logger.warning("⚠️ SENDGRID_API_KEY não configurada - pulando envio.")
        return False
    try:
        logger.info("📧 Enviando e-mail...")
        with open(arquivo, "rb") as f:
            encoded = base64.b64encode(f.read()).decode()
        attachment = Attachment(
            FileContent(encoded),
            FileName(os.path.basename(arquivo)),
            FileType("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"),
            Disposition("attachment"),
        )
        message = Mail(
            from_email=EMAIL_FROM,
            to_emails=EMAIL_TO,
            subject=f"DJEN - Histórico OAB {OAB_NUMERO}/{OAB_UF}",
            html_content=f"""
            <p>Olá,</p>
            <p>Segue planilha com <strong>{total} publicações</strong> da OAB {OAB_NUMERO}/{OAB_UF}.</p>
            <p><strong>Período:</strong> {DATA_INICIO} até {DATA_FIM}</p>
            <p style="color:#666;font-size:12px;"><em>Agente Jurídico DJEN v15.0</em></p>
            """,
        )
        message.attachment = attachment
        sg = SendGridAPIClient(SENDGRID_API_KEY)
        response = sg.send(message)
        if response.status_code in (200, 202):
            logger.info(f"✅ E-mail enviado.")
            return True
        return False
    except Exception as e:
        logger.error(f"❌ Erro ao enviar e-mail: {e}")
        return False

# =========================
# 🔄 MAIN — LOOP HISTÓRICO
# =========================
def main():
    logger.info("🚀 DJEN v15.0 — Modo Histórico")
    logger.info(f"📍 OAB: {OAB_NUMERO}/{OAB_UF}")
    logger.info(f"📅 Período: {DATA_INICIO} até {DATA_FIM}")
    
    try:
        # 0. Preparar banco
        criar_tabela()
        
        # 1. Loop por datas
        data_atual = DATA_INICIO
        total_dias = (DATA_FIM - DATA_INICIO).days + 1
        dia_atual = 0
        
        while data_atual <= DATA_FIM:
            dia_atual += 1
            DATA_BUSCA = data_atual.strftime("%Y-%m-%d")
            
            logger.info(f"📅 [{dia_atual}/{total_dias}] Processando: {DATA_BUSCA}")
            
            # Buscar
            publicacoes = buscar_publicacoes(DATA_BUSCA)
            
            if publicacoes:
                # Processar
                dados = processar_publicacoes(publicacoes)
                # Salvar no SQLite
                if dados:
                    salvar_no_sqlite(dados)
            else:
                logger.debug(f"  📭 Sem publicações em {DATA_BUSCA}")
            
            # Próximo dia + delay para respeitar API
            data_atual += timedelta(days=1)
            time.sleep(1.2)
        
        # 2. Exportar Excel final
        logger.info("📊 Gerando exportação final...")
        arquivo = exportar_sqlite_para_excel()
        
        # 3. Enviar e-mail (opcional)
        if arquivo:
            total_db = consultar_total_registros()
            enviar_email(arquivo, total_db)
            logger.info(f"✅ Processo concluído! Total no banco: {total_db} registros.")
        else:
            logger.warning("⚠️ Nenhum dado para exportar.")
        
    except KeyboardInterrupt:
        logger.warning("⚠️ Interrompido pelo usuário.")
    except Exception as e:
        logger.error(f"❌ Erro crítico: {e}", exc_info=True)
    finally:
        logger.info("🏁 DJEN encerrado.")

if __name__ == "__main__":
    main()
