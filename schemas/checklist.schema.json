{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olv.local/schemas/checklist.schema.json",
  "title": "Schema de Checklist de Peça Processual OLV",
  "description": "Contrato estrutural para listas de verificação destinadas à auditoria de prontidão de peças processuais.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "codigo_peca",
    "nome_peca",
    "itens",
    "versao",
    "status"
  ],

  "properties": {
    "codigo_peca": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },

    "nome_peca": {
      "type": "string"
    },

    "itens": {
      "type": "array",
      "minItems": 1,

      "items": {
        "type": "object",
        "additionalProperties": false,

        "required": [
          "codigo",
          "item",
          "categoria",
          "criticidade",
          "tipo_verificacao",
          "instrucao"
        ],

        "properties": {
          "codigo": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },

          "item": {
            "type": "string"
          },

          "categoria": {
            "type": "string",
            "enum": [
              "identificacao",
              "cabimento",
              "representacao",
              "tempestividade",
              "preparo",
              "estrutura",
              "fatos",
              "sentenca",
              "fundamentacao",
              "provas",
              "prequestionamento",
              "pedidos",
              "coerencia",
              "documentacao",
              "revisao"
            ]
          },

          "criticidade": {
            "type": "string",
            "enum": [
              "critica",
              "alta",
              "media",
              "baixa"
            ]
          },

          "tipo_verificacao": {
            "type": "string",
            "enum": [
              "presenca",
              "confirmacao",
              "condicional",
              "consistencia",
              "calculo",
              "revisao_humana"
            ]
          },

          "instrucao": {
            "type": "string"
          },

          "condicao": {
            "type": "string"
          },

          "fonte": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },

          "bloqueia_finalizacao": {
            "type": "boolean"
          }
        }
      }
    },

    "versao": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },

    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "ativo",
        "inativo",
        "obsoleto"
      ]
    }
  }
}
